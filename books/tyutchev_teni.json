{
    "type": "poetry",
    "blocks": [
        {
            "type": "stanza",
            "ru": ["Тени сизые смесились,", "Цвет поблекнул, звук уснул —", "Жизнь и движенье разрешились", "В сумрак зыбкий, в дальний гул..."],
            "en": ["Blue shadows have mixed,", "Color faded, sound fell asleep —", "Life and movement resolved", "Into shaky twilight, into distant hum..."],
            "bg": "rgba(10, 15, 30, 0.85)", "glow": "rgba(163, 181, 255, 0.4)", "color": "#ffffff",
            "audio": "ambience/deep_forest.ogg, nature/wind_soft.ogg"
        },
        { "type": "spacer" },
        {
            "type": "stanza",
            "ru": ["Мотылька полёт незримый", "Слышен в воздухе ночном...", "Час тоски невыразимой!..", "Всё во мне, и я во всём!.."],
            "en": ["The invisible flight of a moth", "Is heard in the night air...", "Hour of inexpressible anguish!..", "Everything is in me, and I am in everything!.."],
            "bg": "rgba(5, 5, 15, 0.9)", "glow": "rgba(177, 143, 255, 0.6)", "color": "#ffffff",
            "audio": "ambience/night_air.ogg, nature/moth_wings.ogg, music/synth_mystic_pad.ogg"
        }
    ]
}
